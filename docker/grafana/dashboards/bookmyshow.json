        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(reservation_success_total[$__range])) / sum(increase(reservation_attempts_total[$__range]))",
          "legendFormat": "__auto",
          "refId": "A"

# Copy to .env and replace the placeholders:
#
#   copy .env.example .env      (Windows)
#   cp    .env.example .env     (bash)
#
# bookmyshow/settings.py reads this file through python-dotenv, and Docker
# Compose reads it too for ${...} interpolation. Keep the values UNQUOTED and
# without spaces around "=" - Compose's env-file parser is stricter than
# python-dotenv's, and quotes would otherwise end up inside the value.

# Django. DEBUG defaults to true for `manage.py runserver`; the Docker image
# sets DEBUG=false, which makes SECRET_KEY required (Compose has a local-only
# fallback). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# DEBUG=true
# SECRET_KEY=
# Comma-separated; the default covers local runs.
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1],web

# Database
DB_NAME=bookmyshow
DB_USER=root
DB_PASSWORD=change-me
# Only used by a local `python manage.py runserver`;
# Docker Compose overrides this with the `db` service name.
DB_HOST=127.0.0.1
DB_PORT=3306

# Grafana login (http://localhost:3000). Both default to "admin" if unset.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Admin account, created/updated on every container start (docker/entrypoint.sh).
# Needed to create shows - the register endpoint never creates admins - and
# used by scripts/burst.py. Leave empty to skip.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-pass

# Logging (stdout). LOG_FORMAT=json (default) or text; LOG_LEVEL default INFO.
# LOG_FORMAT=text
# LOG_LEVEL=INFO
